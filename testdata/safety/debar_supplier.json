{
  "defaults": {
    "data": {
      "params": {
        "pageNum": 1,
        "pageSize": 20
      }
    },
    "expected": {
      "min_total": 0
    }
  },
  "test_cases": [
    {
      "case_id": "TC_DBS_001",
      "case_name": "基础查询-默认分页",
      "description": "默认分页查询，验证接口正常返回数据，作为baseline",
      "priority": "P0",
      "data": {
        "params": {}
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DBS_002",
      "case_name": "过滤-按企业名称",
      "description": "supplierName=11，验证返回rows的supplierName都为11",
      "priority": "P1",
      "data": {
        "params": {
          "supplierName": "11"
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DBS_003",
      "case_name": "过滤-按法人代表",
      "description": "legalRepresentative=邹凯，验证返回rows的legalRepresentative都为邹凯",
      "priority": "P1",
      "data": {
        "params": {
          "legalRepresentative": "邹凯"
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DBS_004",
      "case_name": "过滤-按营业执照号",
      "description": "businessLicenseNo=21，验证返回rows的businessLicenseNo都为21",
      "priority": "P1",
      "data": {
        "params": {
          "businessLicenseNo": "21"
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DBS_005",
      "case_name": "过滤-按审批状态",
      "description": "approveStatus=2，验证返回rows的approveStatus都为2",
      "priority": "P1",
      "data": {
        "params": {
          "approveStatus": "2"
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DBS_006",
      "case_name": "过滤-按代理部门编码",
      "description": "proxyDeptcode=root，验证返回rows的proxyDeptcode都为root",
      "priority": "P1",
      "data": {
        "params": {
          "proxyDeptcode": "root"
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DBS_007",
      "case_name": "排序-按创建时间升序",
      "description": "orderByColumn=createTime&isAsc=asc，验证返回数据按创建时间升序排列",
      "priority": "P2",
      "data": {
        "params": {
          "orderByColumn": "createTime",
          "isAsc": "asc"
        }
      },
      "expected": {
        "min_total": 1,
        "verify_sorting": true
      }
    },
    {
      "case_id": "TC_DBS_008",
      "case_name": "排序-按创建时间降序",
      "description": "orderByColumn=createTime&isAsc=desc，验证返回数据按创建时间降序排列",
      "priority": "P2",
      "data": {
        "params": {
          "orderByColumn": "createTime",
          "isAsc": "desc"
        }
      },
      "expected": {
        "min_total": 1,
        "verify_sorting": true
      }
    },
    {
      "case_id": "TC_DBS_009",
      "case_name": "组合过滤-企业名称+法人代表",
      "description": "supplierName=11 + legalRepresentative=邹凯，验证rows同时匹配",
      "priority": "P1",
      "data": {
        "params": {
          "supplierName": "11",
          "legalRepresentative": "邹凯"
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DBS_010",
      "case_name": "组合过滤-企业名称+审批状态",
      "description": "supplierName=11 + approveStatus=2，验证rows同时匹配",
      "priority": "P1",
      "data": {
        "params": {
          "supplierName": "11",
          "approveStatus": "2"
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DBS_011",
      "case_name": "边界-空字符串企业名称",
      "description": "supplierName=空字符串，验证是否等同于不传或报错",
      "priority": "P2",
      "data": {
        "params": {
          "supplierName": ""
        }
      },
      "expected": {
        "allow_error": true
      }
    },
    {
      "case_id": "TC_DBS_012",
      "case_name": "边界-不存在的企业名称",
      "description": "supplierName=不存在的企业，验证返回rows为空、total=0",
      "priority": "P2",
      "data": {
        "params": {
          "supplierName": "不存在的企业XYZ_2026"
        }
      },
      "expected": {
        "min_total": 0,
        "expect_empty_rows": true
      }
    }
  ]
}
