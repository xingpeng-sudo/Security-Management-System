{
  "defaults": {
    "data": {
      "params": {
        "pageNum": 1,
        "pageSize": 20
      }
    },
    "expected": {
      "min_total": 0
    }
  },
  "test_cases": [
    {
      "case_id": "TC_DBS_001",
      "case_name": "基础查询",
      "description": "默认分页查询，作为baseline供过滤用例取真实值",
      "priority": "P0",
      "data": {
        "params": {
          "pageNum": 1,
          "pageSize": 20
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DBS_002",
      "case_name": "分页验证-pageSize=1",
      "description": "pageSize=1，验证返回rows最多1条，分页生效",
      "priority": "P1",
      "data": {
        "params": {
          "pageNum": 1,
          "pageSize": 1
        }
      },
      "expected": {
        "min_total": 0,
        "max_rows": 1
      }
    },
    {
      "case_id": "TC_DBS_003",
      "case_name": "过滤-按企业名称",
      "description": "从baseline取真实supplierName值过滤，验证返回rows都匹配且结果数<=baseline",
      "priority": "P1",
      "data": {
        "filter_fields": ["supplierName"]
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DBS_004",
      "case_name": "组合过滤-企业名+法人",
      "description": "从baseline取真实supplierName+legalRepresentative组合过滤，验证rows同时匹配两个条件",
      "priority": "P1",
      "data": {
        "filter_fields": ["supplierName", "legalRepresentative"]
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DBS_005",
      "case_name": "边界-pageNum超出范围",
      "description": "pageNum=9999，验证返回空rows且code=0",
      "priority": "P2",
      "data": {
        "params": {
          "pageNum": 9999,
          "pageSize": 20
        }
      },
      "expected": {
        "min_total": 0,
        "expect_empty_rows": true
      }
    }
  ]
}
