{
  "defaults": {
    "data": {
      "params": {
        "pageNum": 1,
        "pageSize": 20
      }
    },
    "expected": {
      "min_total": 0
    }
  },
  "test_cases": [
    {
      "case_id": "TC_SUP_001",
      "case_name": "基础查询-默认分页",
      "description": "pageNum=1, pageSize=20 查询相关方企业列表，作为baseline供后续过滤用例取值",
      "priority": "P0",
      "data": {
        "params": {
          "pageNum": 1,
          "pageSize": 20
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_SUP_002",
      "case_name": "第二页查询",
      "description": "pageNum=2 验证分页功能，若总数<=20则自动跳过",
      "priority": "P1",
      "data": {
        "params": {
          "pageNum": 2,
          "pageSize": 20
        }
      },
      "expected": {
        "min_total": 0,
        "verify_pagination": true
      }
    },
    {
      "case_id": "TC_SUP_003",
      "case_name": "最小页大小-pageSize=1",
      "description": "pageSize=1 验证返回rows最多1条",
      "priority": "P1",
      "data": {
        "params": {
          "pageNum": 1,
          "pageSize": 1
        }
      },
      "expected": {
        "min_total": 0,
        "max_rows": 1
      }
    },
    {
      "case_id": "TC_SUP_004",
      "case_name": "大页大小-pageSize=100",
      "description": "pageSize=100 验证大页量正常返回",
      "priority": "P2",
      "data": {
        "params": {
          "pageNum": 1,
          "pageSize": 100
        }
      },
      "expected": {
        "min_total": 0,
        "max_rows": 100
      }
    },
    {
      "case_id": "TC_SUP_005",
      "case_name": "边界-pageNum=0",
      "description": "pageNum=0 非法页码，验证系统容错",
      "priority": "P2",
      "data": {
        "params": {
          "pageNum": 0,
          "pageSize": 20
        }
      },
      "expected": {
        "allow_error": true
      }
    },
    {
      "case_id": "TC_SUP_006",
      "case_name": "边界-pageNum超出总页数",
      "description": "pageNum=9999 验证返回空rows",
      "priority": "P2",
      "data": {
        "params": {
          "pageNum": 9999,
          "pageSize": 20
        }
      },
      "expected": {
        "min_total": 0,
        "expect_empty_rows": true
      }
    },
    {
      "case_id": "TC_SUP_007",
      "case_name": "边界-pageSize=0",
      "description": "pageSize=0 非法页大小，验证系统容错",
      "priority": "P2",
      "data": {
        "params": {
          "pageNum": 1,
          "pageSize": 0
        }
      },
      "expected": {
        "allow_error": true
      }
    },
    {
      "case_id": "TC_SUP_008",
      "case_name": "边界-负数分页",
      "description": "pageNum=-1, pageSize=-1 验证系统容错",
      "priority": "P2",
      "data": {
        "params": {
          "pageNum": -1,
          "pageSize": -1
        }
      },
      "expected": {
        "allow_error": true
      }
    },
    {
      "case_id": "TC_SUP_009",
      "case_name": "过滤-按企业名称",
      "description": "从baseline取真实supplierName值过滤，验证返回的rows都匹配该企业名称",
      "priority": "P1",
      "data": {
        "filter_fields": ["supplierName"]
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_SUP_010",
      "case_name": "过滤-按营业执照号",
      "description": "从baseline取真实businessLicenseNo值过滤，验证返回的rows都匹配该营业执照号",
      "priority": "P1",
      "data": {
        "filter_fields": ["businessLicenseNo"]
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_SUP_011",
      "case_name": "过滤-按法定代表人",
      "description": "从baseline取真实legalRepresentative值过滤，验证返回的rows都匹配该法人",
      "priority": "P1",
      "data": {
        "filter_fields": ["legalRepresentative"]
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_SUP_012",
      "case_name": "过滤-按发证机关",
      "description": "从baseline取真实blIssuingAuthority值过滤，验证返回的rows都匹配该发证机关",
      "priority": "P2",
      "data": {
        "filter_fields": ["blIssuingAuthority"]
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_SUP_013",
      "case_name": "过滤-按联系人姓名",
      "description": "从baseline取真实contactsName值过滤，验证返回的rows都匹配该联系人",
      "priority": "P2",
      "data": {
        "filter_fields": ["contactsName"]
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_SUP_014",
      "case_name": "过滤-按联系人电话",
      "description": "从baseline取真实contactsPhone值过滤，验证返回的rows都匹配该电话",
      "priority": "P2",
      "data": {
        "filter_fields": ["contactsPhone"]
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_SUP_015",
      "case_name": "组合过滤-企业名+法人",
      "description": "从baseline取真实supplierName+legalRepresentative组合过滤，验证返回rows同时匹配两个条件",
      "priority": "P1",
      "data": {
        "filter_fields": ["supplierName", "legalRepresentative"]
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_SUP_016",
      "case_name": "不存在的企业名称过滤",
      "description": "用不存在的supplierName值过滤，验证返回空rows且code=0",
      "priority": "P2",
      "data": {
        "params": {
          "pageNum": 1,
          "pageSize": 20,
          "supplierName": "不存在的企业XYZ999"
        }
      },
      "expected": {
        "min_total": 0,
        "expect_empty_rows": true
      }
    },
    {
      "case_id": "TC_SUP_017",
      "case_name": "安全-SQL注入过滤",
      "description": "supplierName传SQL注入字符，验证系统安全处理，返回空rows",
      "priority": "P2",
      "data": {
        "params": {
          "pageNum": 1,
          "pageSize": 20,
          "supplierName": "' OR '1'='1"
        }
      },
      "expected": {
        "min_total": 0,
        "expect_empty_rows": true
      }
    }
  ]
}
