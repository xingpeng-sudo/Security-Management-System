{
  "defaults": {
    "data": {
      "params": {
        "pageNum": 1,
        "pageSize": 20
      }
    },
    "expected": {
      "min_total": 0
    }
  },
  "test_cases": [
    {
      "case_id": "TC_SUP_001",
      "case_name": "基础查询-默认分页",
      "description": "默认分页查询，验证接口正常返回数据，作为baseline",
      "priority": "P0",
      "data": {
        "params": {}
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_SUP_002",
      "case_name": "过滤-按企业名称",
      "description": "supplierName=A，验证返回rows的supplierName都为A",
      "priority": "P1",
      "data": {
        "params": {
          "supplierName": "A"
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_SUP_003",
      "case_name": "过滤-按营业执照号",
      "description": "businessLicenseNo=914107287425452612，验证返回rows的businessLicenseNo都匹配",
      "priority": "P1",
      "data": {
        "params": {
          "businessLicenseNo": "914107287425452612"
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_SUP_004",
      "case_name": "过滤-按法人代表",
      "description": "legalRepresentative=崔培军，验证返回rows的legalRepresentative都为崔培军",
      "priority": "P1",
      "data": {
        "params": {
          "legalRepresentative": "崔培军"
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_SUP_005",
      "case_name": "过滤-按发证机关",
      "description": "blIssuingAuthority=营口市行政审批局，验证返回rows的blIssuingAuthority都匹配",
      "priority": "P1",
      "data": {
        "params": {
          "blIssuingAuthority": "营口市行政审批局"
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_SUP_006",
      "case_name": "排序-按创建时间升序",
      "description": "orderByColumn=createTime&isAsc=asc，验证返回数据按创建时间升序排列",
      "priority": "P2",
      "data": {
        "params": {
          "orderByColumn": "createTime",
          "isAsc": "asc"
        }
      },
      "expected": {
        "min_total": 1,
        "verify_sorting": true
      }
    },
    {
      "case_id": "TC_SUP_007",
      "case_name": "排序-按创建时间降序",
      "description": "orderByColumn=createTime&isAsc=desc，验证返回数据按创建时间降序排列",
      "priority": "P2",
      "data": {
        "params": {
          "orderByColumn": "createTime",
          "isAsc": "desc"
        }
      },
      "expected": {
        "min_total": 1,
        "verify_sorting": true
      }
    },
    {
      "case_id": "TC_SUP_008",
      "case_name": "组合过滤-企业名称+法人代表",
      "description": "supplierName=A + legalRepresentative=崔培军，验证rows同时匹配两个条件",
      "priority": "P1",
      "data": {
        "params": {
          "supplierName": "A",
          "legalRepresentative": "崔培军"
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_SUP_009",
      "case_name": "组合过滤-企业名称+营业执照号",
      "description": "supplierName=A + businessLicenseNo=914107287425452612，验证rows同时匹配",
      "priority": "P1",
      "data": {
        "params": {
          "supplierName": "A",
          "businessLicenseNo": "914107287425452612"
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_SUP_010",
      "case_name": "边界-空字符串企业名称",
      "description": "supplierName=空字符串，验证是否等同于不传或报错",
      "priority": "P2",
      "data": {
        "params": {
          "supplierName": ""
        }
      },
      "expected": {
        "allow_error": true
      }
    },
    {
      "case_id": "TC_SUP_011",
      "case_name": "边界-不存在的企业名称",
      "description": "supplierName=不存在的企业，验证返回rows为空、total=0",
      "priority": "P2",
      "data": {
        "params": {
          "supplierName": "不存在的企业XYZ_2026"
        }
      },
      "expected": {
        "min_total": 0,
        "expect_empty_rows": true
      }
    },
    {
      "case_id": "TC_SUP_012",
      "case_name": "分页-pageSize=1翻页数据不重复",
      "description": "pageSize=1查询第1页和第2页，验证两页rows无交集（分页核心场景，覆盖分页逻辑正确性）",
      "priority": "P1",
      "data": {
        "params": {
          "pageSize": 1
        }
      },
      "expected": {
        "min_total": 2,
        "verify_pagination_no_overlap": true
      }
    },
    {
      "case_id": "TC_SUP_013",
      "case_name": "过滤完整性-按营业执照号",
      "description": "businessLicenseNo精确匹配，验证接口过滤结果与全量本地过滤一致（发现漏数据bug）",
      "priority": "P1",
      "data": {
        "params": {
          "businessLicenseNo": "914107287425452612"
        }
      },
      "expected": {
        "min_total": 1,
        "verify_filter_completeness": true
      }
    }
  ]
}
