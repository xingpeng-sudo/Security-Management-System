{
  "defaults": {
    "data": {
      "params": {
        "pageNum": 1,
        "pageSize": 20
      }
    },
    "expected": {
      "min_total": 0
    }
  },
  "test_cases": [
    {
      "case_id": "TC_DEM_001",
      "case_name": "基础查询-默认分页",
      "description": "pageNum=1, pageSize=20 查询人员黑名单列表，作为baseline供后续过滤用例取值",
      "priority": "P0",
      "data": {
        "params": {
          "pageNum": 1,
          "pageSize": 20
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DEM_002",
      "case_name": "第二页查询",
      "description": "pageNum=2 验证分页功能，若总数<=20则自动跳过",
      "priority": "P1",
      "data": {
        "params": {
          "pageNum": 2,
          "pageSize": 20
        }
      },
      "expected": {
        "min_total": 0,
        "verify_pagination": true
      }
    },
    {
      "case_id": "TC_DEM_003",
      "case_name": "最小页大小-pageSize=1",
      "description": "pageSize=1 验证返回rows最多1条",
      "priority": "P1",
      "data": {
        "params": {
          "pageNum": 1,
          "pageSize": 1
        }
      },
      "expected": {
        "min_total": 0,
        "max_rows": 1
      }
    },
    {
      "case_id": "TC_DEM_004",
      "case_name": "大页大小-pageSize=100",
      "description": "pageSize=100 验证大页量正常返回",
      "priority": "P2",
      "data": {
        "params": {
          "pageNum": 1,
          "pageSize": 100
        }
      },
      "expected": {
        "min_total": 0,
        "max_rows": 100
      }
    },
    {
      "case_id": "TC_DEM_005",
      "case_name": "边界-pageNum=0",
      "description": "pageNum=0 非法页码，验证系统容错",
      "priority": "P2",
      "data": {
        "params": {
          "pageNum": 0,
          "pageSize": 20
        }
      },
      "expected": {
        "allow_error": true
      }
    },
    {
      "case_id": "TC_DEM_006",
      "case_name": "边界-pageNum超出总页数",
      "description": "pageNum=9999 验证返回空rows",
      "priority": "P2",
      "data": {
        "params": {
          "pageNum": 9999,
          "pageSize": 20
        }
      },
      "expected": {
        "min_total": 0,
        "expect_empty_rows": true
      }
    },
    {
      "case_id": "TC_DEM_007",
      "case_name": "边界-pageSize=0",
      "description": "pageSize=0 非法页大小，验证系统容错",
      "priority": "P2",
      "data": {
        "params": {
          "pageNum": 1,
          "pageSize": 0
        }
      },
      "expected": {
        "allow_error": true
      }
    },
    {
      "case_id": "TC_DEM_008",
      "case_name": "边界-负数分页",
      "description": "pageNum=-1, pageSize=-1 验证系统容错",
      "priority": "P2",
      "data": {
        "params": {
          "pageNum": -1,
          "pageSize": -1
        }
      },
      "expected": {
        "allow_error": true
      }
    },
    {
      "case_id": "TC_DEM_009",
      "case_name": "过滤-按人员姓名",
      "description": "从baseline取真实empName值过滤，验证返回的rows都匹配该姓名",
      "priority": "P1",
      "data": {
        "filter_fields": ["empName"]
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DEM_010",
      "case_name": "过滤-按身份证号",
      "description": "从baseline取真实idcardNo值过滤，验证返回的rows都匹配该身份证号",
      "priority": "P1",
      "data": {
        "filter_fields": ["idcardNo"]
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DEM_011",
      "case_name": "过滤-按审批状态",
      "description": "从baseline取真实approveStatus值过滤，验证返回的rows都匹配该审批状态",
      "priority": "P1",
      "data": {
        "filter_fields": ["approveStatus"]
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DEM_012",
      "case_name": "过滤-按禁入状态",
      "description": "从baseline取真实debarStatus值过滤，验证返回的rows都匹配该禁入状态",
      "priority": "P1",
      "data": {
        "filter_fields": ["debarStatus"]
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DEM_013",
      "case_name": "组合过滤-姓名+身份证",
      "description": "从baseline取真实empName+idcardNo组合过滤，验证返回rows同时匹配两个条件",
      "priority": "P1",
      "data": {
        "filter_fields": ["empName", "idcardNo"]
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DEM_014",
      "case_name": "不存在的人员姓名过滤",
      "description": "用不存在的empName值过滤，验证返回空rows且code=0",
      "priority": "P2",
      "data": {
        "params": {
          "pageNum": 1,
          "pageSize": 20,
          "empName": "不存在的名字XYZ999"
        }
      },
      "expected": {
        "min_total": 0,
        "expect_empty_rows": true
      }
    },
    {
      "case_id": "TC_DEM_015",
      "case_name": "安全-SQL注入过滤",
      "description": "empName传SQL注入字符，验证系统安全处理，返回空rows",
      "priority": "P2",
      "data": {
        "params": {
          "pageNum": 1,
          "pageSize": 20,
          "empName": "' OR '1'='1"
        }
      },
      "expected": {
        "min_total": 0,
        "expect_empty_rows": true
      }
    }
  ]
}
