{
  "defaults": {
    "data": {
      "params": {
        "pageNum": 1,
        "pageSize": 20
      }
    },
    "expected": {
      "min_total": 0
    }
  },
  "test_cases": [
    {
      "case_id": "TC_DEM_001",
      "case_name": "基础查询-默认分页",
      "description": "默认分页查询，验证接口正常返回数据，作为baseline",
      "priority": "P0",
      "data": {
        "params": {}
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DEM_002",
      "case_name": "过滤-按人员姓名",
      "description": "empName=郭玉昌，验证返回rows的empName都为郭玉昌",
      "priority": "P1",
      "data": {
        "params": {
          "empName": "郭玉昌"
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DEM_003",
      "case_name": "过滤-按身份证号",
      "description": "idcardNo=372522198104111416，验证返回rows的idcardNo都匹配",
      "priority": "P1",
      "data": {
        "params": {
          "idcardNo": "372522198104111416"
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DEM_004",
      "case_name": "过滤-按审批状态",
      "description": "approveStatus=4，验证返回rows的approveStatus都为4",
      "priority": "P1",
      "data": {
        "params": {
          "approveStatus": "4"
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DEM_005",
      "case_name": "过滤-按拉黑状态",
      "description": "debarStatus=0，验证返回rows的debarStatus都为0",
      "priority": "P1",
      "data": {
        "params": {
          "debarStatus": "0"
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DEM_006",
      "case_name": "过滤-按委托部门编码",
      "description": "entrustDeptcode=YV900，验证返回rows的entrustDeptcode都为YV900",
      "priority": "P1",
      "data": {
        "params": {
          "entrustDeptcode": "YV900"
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DEM_007",
      "case_name": "排序-按创建时间升序",
      "description": "orderByColumn=createTime&isAsc=asc，验证返回数据按创建时间升序排列",
      "priority": "P2",
      "data": {
        "params": {
          "orderByColumn": "createTime",
          "isAsc": "asc"
        }
      },
      "expected": {
        "min_total": 1,
        "verify_sorting": true
      }
    },
    {
      "case_id": "TC_DEM_008",
      "case_name": "排序-按创建时间降序",
      "description": "orderByColumn=createTime&isAsc=desc，验证返回数据按创建时间降序排列",
      "priority": "P2",
      "data": {
        "params": {
          "orderByColumn": "createTime",
          "isAsc": "desc"
        }
      },
      "expected": {
        "min_total": 1,
        "verify_sorting": true
      }
    },
    {
      "case_id": "TC_DEM_009",
      "case_name": "组合过滤-姓名+身份证",
      "description": "empName=郭玉昌 + idcardNo=372522198104111416，验证rows同时匹配",
      "priority": "P1",
      "data": {
        "params": {
          "empName": "郭玉昌",
          "idcardNo": "372522198104111416"
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DEM_010",
      "case_name": "组合过滤-姓名+审批状态",
      "description": "empName=郭玉昌 + approveStatus=4，验证rows同时匹配",
      "priority": "P1",
      "data": {
        "params": {
          "empName": "郭玉昌",
          "approveStatus": "4"
        }
      },
      "expected": {
        "min_total": 1
      }
    },
    {
      "case_id": "TC_DEM_011",
      "case_name": "边界-空字符串姓名",
      "description": "empName=空字符串，验证是否等同于不传或报错",
      "priority": "P2",
      "data": {
        "params": {
          "empName": ""
        }
      },
      "expected": {
        "allow_error": true
      }
    },
    {
      "case_id": "TC_DEM_012",
      "case_name": "边界-不存在的身份证号",
      "description": "idcardNo=不存在的号码，验证返回rows为空、total=0",
      "priority": "P2",
      "data": {
        "params": {
          "idcardNo": "999999999999999999"
        }
      },
      "expected": {
        "min_total": 0,
        "expect_empty_rows": true
      }
    }
  ]
}
